{
  "expo": {
    "name": "ValidaCB",
    "slug": "valida-cb",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "validacb",
    "userInterfaceStyle": "light",
    "splash": {
      "backgroundColor": "#3D1E10"
    },
    "ios": {
      "supportsTablet": false,
      "infoPlist": {
        "NSCameraUsageDescription": "O ValidaCB precisa de acesso à câmera para escanear códigos de barras de produtos."
      }
    },
    "android": {
      "package": "com.fatec.validacb",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#3D1E10",
        "foregroundImage": "./assets/android-icon-foreground.png"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.VIBRATE",
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "plugins": [
      "expo-router",
      [
        "expo-camera",
        {
          "cameraPermission": "O ValidaCB precisa de acesso à câmera para escanear códigos de barras de produtos."
        }
      ]
    ],
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "689131b5-3a02-47a7-835a-c70de683877a"
      }
    }
  }
}
