{
  "name": "valida-bauducco-backend",
  "version": "1.0.0",
  "type": "module",
  "description": "API REST para controle de validade e lotes - ValidaBauducco",
  "main": "dist/server.cjs",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "prisma generate && tsup src --out-dir dist",
    "start": "node dist/server.cjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:studio": "prisma studio"
  },
  "keywords": [
    "fastify",
    "prisma",
    "typescript",
    "bauducco",
    "validade"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@fastify/cors": "^11.3.0",
    "@fastify/jwt": "^10.2.2",
    "@fastify/swagger": "^9.8.1",
    "@fastify/swagger-ui": "^6.1.1",
    "@prisma/client": "^6.19.3",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^26.3.0",
    "@types/node-cron": "^3.0.11",
    "bcryptjs": "^3.0.3",
    "dayjs": "^1.11.23",
    "dotenv": "^17.4.2",
    "expo-server-sdk": "^7.2.0",
    "fastify": "^5.12.1",
    "node-cron": "^4.6.0",
    "prisma": "^6.19.3",
    "tsup": "^8.5.1",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "vitest": "^4.1.11"
  }
