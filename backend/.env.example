# Ambiente
NODE_ENV=development
PORT=3333
HOST=0.0.0.0

# Conexão com o Banco de Dados (PostgreSQL no Neon ou Local)
# Exemplo Neon: postgresql://[user]:[password]@[endpoint].neon.tech/neondb?sslmode=require
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/valida_bauducco?schema=public"

# Autenticação JWT
JWT_SECRET="valida_bauducco_jwt_super_secret_key_change_in_production"

# Configuração de Notificações
TZ="America/Sao_Paulo"
